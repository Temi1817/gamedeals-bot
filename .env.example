# --- обязательное -----------------------------------------------------------

# Токен бота от @BotFather
BOT_TOKEN=123456:AAAA-your-telegram-bot-token

# Ключ IsThereAnyDeal: https://isthereanydeal.com/apps/my/
# Без него бот работает, но цены будут только от Steam / Epic / CheapShark.
ITAD_API_KEY=

# --- регион -----------------------------------------------------------------

DEFAULT_COUNTRY=KZ
DEFAULT_CURRENCY=KZT
TIMEZONE=Asia/Almaty

# --- база -------------------------------------------------------------------

DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# --- расписание -------------------------------------------------------------

# Как часто проверять вотчлист, минут
PRICE_CHECK_INTERVAL_MINUTES=60
# Час автопоста бесплатных раздач (по TIMEZONE), 0-23
FREE_GAMES_POST_HOUR=20

# --- транспорт --------------------------------------------------------------

# false — long polling (разработка); true — вебхук (прод)
USE_WEBHOOK=false
WEBHOOK_BASE_URL=https://example.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# --- прочее -----------------------------------------------------------------

HTTP_TIMEOUT=10.0
LOG_LEVEL=INFO
# true — JSON-логи (прод), false — читаемые в консоли
LOG_JSON=false
